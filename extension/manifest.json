{
  "manifest_version": 3,
  "name": "拾叶 · 智能书签",
  "version": "1.2.3",
  "description": "收藏时智能推荐已有文件夹，在全部书签中搜索，并连接你自己的大模型 API。",
  "minimum_chrome_version": "127",
  "permissions": ["bookmarks", "storage", "tabs", "activeTab", "scripting", "notifications", "unlimitedStorage"],
  "host_permissions": ["https://api.deepseek.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "拾叶 · 收藏与搜索",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "options_page": "manager.html#settings",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
